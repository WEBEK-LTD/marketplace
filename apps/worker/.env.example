# worker: environment variable names only; the inventory in README.md describes each one.
# Copy to .env for local development and set the values locally. Never commit .env files.
# Delete the lines you do not set: an empty value is invalid, while an unset optional variable uses its default.
# Loaded only by `pnpm run dev` (node --env-file-if-exists=.env).
NODE_ENV=
LOG_LEVEL=
PSEUDONYMOUS_USER_ID_KEY=
REDIS_URL=
WORKER_CONCURRENCY=
WORKER_HEALTH_HOST=
WORKER_HEALTH_PORT=
WORKER_SHUTDOWN_TIMEOUT_MS=
APP_WORKER_DATABASE_URL=
APP_WORKER_DATABASE_MAX_CONNECTIONS=
EMAIL_RELAY_INTERVAL_MS=
OUTBOX_RELAY_INTERVAL_MS=
OUTBOX_SWEEPER_INTERVAL_MS=
