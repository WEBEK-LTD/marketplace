# web: environment variable names only; the inventory in README.md describes each one.
# Copy to .env for local development and set the values locally. Never commit .env files.
# Delete the lines you do not set: an empty value is invalid, while an unset optional variable uses its default.
# Next.js loads .env files itself.
API_BASE_URL=
INTERNAL_BFF_CREDENTIAL=
# Optional, and deferred until the production domain exists. Leave it unset and the app runs normally:
# robots.txt is served without a Sitemap directive and the sitemaps answer 404. Set it to the bare
# origin - scheme and host, no trailing slash - and they turn on with no other change.
PUBLIC_WEB_ORIGIN=
