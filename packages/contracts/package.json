{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "generate": "tsc -p tsconfig.json && node scripts/write-openapi.mjs && orval --config orval.config.mjs",
    "check-generated": "tsc -p tsconfig.json && node scripts/check-generated.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "orval": "8.27.0"
  }
}
